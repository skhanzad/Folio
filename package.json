{
  "name": "folio-jev-reviewer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"uv run uvicorn server.app:app --reload --host 127.0.0.1 --port 8000\" \"vite --host 127.0.0.1\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "uv run uvicorn server.app:app --host 127.0.0.1 --port 8000",
    "test": "uv run pytest -q",
    "test:e2e": "playwright test",
    "report": "latexmk -pdf -interaction=nonstopmode -halt-on-error -outdir=reports reports/findings.tex"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.5",
    "@fontsource/instrument-serif": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.51.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "prettier": "^3.9.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
