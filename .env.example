# Keep credentials on the server. Either variable is accepted.
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
# Optional; maximum simultaneous requests to Jev across all reviews.
JEV_CONCURRENCY=3

# Optional override; defaults to artifacts/iclr2026-model.json.
# FOLIO_ACCEPTANCE_MODEL=/absolute/path/to/model.json
